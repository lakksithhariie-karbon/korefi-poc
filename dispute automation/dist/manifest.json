{
  "manifest_version": 3,
  "name": "KoreFi Dispute Assistant",
  "version": "0.12.1",
  "description": "Ask KoreFi about the DoorDash or Uber Eats order on screen: it checks the evidence, suggests whether to dispute, and drafts the response.",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.doordash.com/*",
    "https://*.ubereats.com/*",
    "https://korefi-pi-dispute-agent.onrender.com/*",
    "https://media-platform.cdn4dd.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "KoreFi Dispute Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.doordash.com/*",
        "https://*.ubereats.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"
  }
}