{
  "manifest_version": 3,
  "name": "KoreFi Dispute Assistant",
  "version": "0.7.0",
  "description": "Chat-first KoreFi dispute agent: capture a redacted DoorDash order, investigate with Pi, draft a response, and log what you filed.",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.doordash.com/*",
    "https://korefi-pi-dispute-agent.onrender.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "KoreFi Dispute Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.doordash.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"
  }
}