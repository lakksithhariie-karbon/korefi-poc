{
  "name": "korefi-dispute-assistant",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "DoorDash Chrome side-panel: redacted full-order capture, Pi investigations, editable dispute draft, and operator-confirmed filing log.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/ && npm --prefix agent-backend test",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.browsers node e2e/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
